
# SentinelPay environment variables
# Copy this file to .env for local development.
# Never commit .env or real credentials to GitHub.

# =========================================================
# Database configuration
# =========================================================

DATABASE_URL=
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=

# =========================================================
# JWT authentication
# =========================================================

# Generate an RSA key pair locally.
# Store the private and public keys securely in your .env file.
# Never commit a real private key.

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# =========================================================
# Session security
# =========================================================

# Generate unique random secrets for local development.
# Example: openssl rand -hex 32

SESSION_SIGNING_KEY=
RATE_LIMIT_KEY_SECRET=

# =========================================================
# AWS configuration
# =========================================================

# Prefer IAM roles or AWS profiles instead of static access keys.
# Leave these empty unless your local environment requires them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1

# =========================================================
# BVN provider configuration
# =========================================================

BVN_CBN_URL=https://api.mock-cbn.local/bvn
BVN_PROVIDER_NG_URL=https://api.mock-provider-ng.local/bvn

# =========================================================
# KYC configuration
# =========================================================

KYC_BUCKET=sentinelpay-kyc-documents

# =========================================================
# Webhook and application configuration
# =========================================================

WEBHOOK_TIMEOUT=10
ENVIRONMENT=development

# Configure an actual Slack webhook only in your local .env
SLACK_WEBHOOK=

# =========================================================
# Partner API configuration
# =========================================================

PARTNER_API_KEY=

# =========================================================
# Production database configuration
# =========================================================

# Production passwords must be managed using a secrets manager.
PROD_DB_PASSWORD=
